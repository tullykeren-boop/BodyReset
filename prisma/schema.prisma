generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkdayType {
  MEETINGS
  DEEPWORK
  CREATIVE
  MIXED
}

enum Goal {
  REDUCE_PAIN
  PREVENT
  MOBILITY
  ENERGY
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionSlot {
  MORNING
  MIDDAY
  EVENING
  ADHOC
}

enum CheckInMood {
  GREAT
  OKAY
  TENSE
  PAIN
}

enum CoachRole {
  USER
  ASSISTANT
}

enum SubscriptionPlan {
  PERSONAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stripeCustomerId String? @unique

  profile       Profile?
  dailyPlans    DailyPlan[]
  checkIns      CheckIn[]
  coachMessages CoachMessage[]
  subscription  Subscription?
}

// One per user: the answers from onboarding that drive daily plan generation.
model Profile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  workdayType          WorkdayType
  timeAvailableMinutes Int
  goal                 Goal
  onboardedAt          DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  painAreas ProfilePainArea[]
}

model BodyArea {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  sortOrder   Int    @default(0)

  profiles     ProfilePainArea[]
  muscleGroups BodyAreaMuscleGroup[]
}

model ProfilePainArea {
  profileId  String
  bodyAreaId String

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bodyArea BodyArea @relation(fields: [bodyAreaId], references: [id], onDelete: Cascade)

  @@id([profileId, bodyAreaId])
}

model MuscleGroup {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  bodyAreas BodyAreaMuscleGroup[]
  exercises ExerciseMuscleGroup[]
}

// Join table: which muscle groups are relevant to a body area, and how strongly.
// weight: 1 = primary driver of discomfort in this area, 2 = secondary/supporting
model BodyAreaMuscleGroup {
  bodyAreaId    String
  muscleGroupId String
  weight        Int @default(1)

  bodyArea    BodyArea    @relation(fields: [bodyAreaId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([bodyAreaId, muscleGroupId])
}

model Exercise {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String
  instructions    String
  difficulty      Difficulty @default(BEGINNER)
  durationSeconds Int        @default(40)
  // Which onboarding goals this exercise is well-suited for.
  goals           Goal[]
  equipment       String     @default("none")
  createdAt       DateTime   @default(now())

  muscleGroups     ExerciseMuscleGroup[]
  plannedExercises PlannedSessionExercise[]
}

model ExerciseMuscleGroup {
  exerciseId    String
  muscleGroupId String
  isPrimary     Boolean @default(true)

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
}

// One per user per calendar day: the 3 generated recovery sessions for that day.
model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // normalized to midnight UTC of the plan's day
  createdAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]

  @@unique([userId, date])
}

model PlannedSession {
  id              String      @id @default(cuid())
  dailyPlanId     String
  slot            SessionSlot
  title           String
  focusLabel      String
  durationMinutes Int
  startedAt       DateTime?
  completedAt     DateTime?
  skippedAt       DateTime?

  dailyPlan DailyPlan                @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  exercises PlannedSessionExercise[]
  feedback  SessionFeedback?

  @@index([dailyPlanId, slot])
}

model PlannedSessionExercise {
  id               String @id @default(cuid())
  plannedSessionId String
  exerciseId       String
  order            Int
  durationSeconds  Int

  plannedSession PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])

  @@unique([plannedSessionId, order])
}

model SessionFeedback {
  id               String   @id @default(cuid())
  plannedSessionId String   @unique
  painBefore       Int
  painAfter        Int
  helped           Boolean
  durationRight    Boolean
  wantMore         Boolean
  createdAt        DateTime @default(now())

  plannedSession PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
}

// One per user per calendar day: the quick "how's your body feeling" check-in.
model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  date      DateTime // normalized to midnight UTC
  mood      CheckInMood
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CoachMessage {
  id                      String    @id @default(cuid())
  userId                  String
  role                    CoachRole
  content                 String
  suggestedFocus          String?
  suggestedDurationMinutes Int?
  createdAt               DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan?
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
