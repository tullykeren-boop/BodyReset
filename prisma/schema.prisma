generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkdayType {
  MEETINGS
  DEEPWORK
  CREATIVE
  MIXED
}

enum Goal {
  REDUCE_PAIN
  PREVENT
  MOBILITY
  ENERGY
  REDUCE_STRESS
  IMPROVE_FOCUS
  LIFT_MOOD
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionSlot {
  MORNING
  MIDDAY
  EVENING
  ADHOC
}

enum CheckInMood {
  GREAT
  OKAY
  TENSE
  PAIN
  STRESSED
  FOGGY
  DRAINED
  LOW
}

enum CoachRole {
  USER
  ASSISTANT
}

enum SubscriptionPlan {
  PERSONAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// A concern is anything a routine can be aimed at. Physical and mental are
// siblings, not separate hierarchies -- the only difference is `kind`.
enum ConcernKind {
  PHYSICAL
  MENTAL
}

// How a concern is measured before/after a session. The polarity of each scale
// (whether a higher number is better or worse) lives in src/lib/intensity.ts.
enum IntensityScale {
  PAIN // 0 fine     -> 10 painful       lower is better
  STRESS // 0 calm     -> 10 overwhelmed   lower is better
  TENSION // 0 loose    -> 10 gripped       lower is better
  ENERGY // 0 drained  -> 10 charged       higher is better
  FOCUS // 0 scattered-> 10 sharp         higher is better
  MOOD // 0 flat     -> 10 bright        higher is better
}

enum Modality {
  MOVEMENT
  BREATHWORK
  GAZE
  SOMATIC
  COGNITIVE
  MINDFULNESS
}

enum Posture {
  SEATED
  STANDING
  FLOOR
  ANY
}

enum StateSource {
  CHECK_IN
  INSTANT
  COACH
}

enum SessionOrigin {
  DAILY_PLAN
  COACH
  INSTANT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stripeCustomerId String? @unique

  profile       Profile?
  dailyPlans    DailyPlan[]
  checkIns      CheckIn[]
  coachMessages CoachMessage[]
  subscription  Subscription?
  stateLogs     StateLog[]
  pushSubscriptions PushSubscription[]
  reminderSchedule  ReminderSchedule?
}

// One per user: the answers from onboarding that drive daily plan generation.
model Profile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  workdayType          WorkdayType
  timeAvailableMinutes Int
  goal                 Goal
  onboardedAt          DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns ProfileConcern[]
}

// Mapped to the original "BodyArea" table so the rename costs no data.
model Concern {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  kind        ConcernKind @default(PHYSICAL)
  sortOrder   Int         @default(0)

  // Copy for the "I feel ___ right now" chip, e.g. "Stressed", "Neck is tight".
  stateLabel String @default("")
  // Which scale this concern's before/after readings are taken on.
  scale      IntensityScale @default(PAIN)

  profiles         ProfileConcern[]
  mechanisms       ConcernMechanism[]
  practices        PracticeConcern[]
  stateLogs        StateLogConcern[]
  plannedSessions  PlannedSessionConcern[]
  feedbackReadings SessionFeedbackReading[]

  @@index([kind, sortOrder])
  @@map("BodyArea")
}

model ProfileConcern {
  profileId String
  concernId String @map("bodyAreaId")
  rank      Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  concern Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([profileId, concernId])
  @@map("ProfilePainArea")
}

// The thing a practice acts on. Deliberately has NO `kind`: leaving it untyped
// is what lets physical and mental concerns cross-link for free -- `stress` can
// route to `upper-back` (trapezius holds stress) and `neck` can route to
// `parasympathetic-downshift` without any escape hatch.
model Mechanism {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  concerns  ConcernMechanism[]
  practices PracticeMechanism[]

  @@map("MuscleGroup")
}

// How relevant a mechanism is to a concern, 0-100. 100 = core driver.
// Replaces the old inverted {1 = primary, 2 = secondary} weight.
model ConcernMechanism {
  concernId   String @map("bodyAreaId")
  mechanismId String @map("muscleGroupId")
  weight      Int    @default(60)

  concern   Concern   @relation(fields: [concernId], references: [id], onDelete: Cascade)
  mechanism Mechanism @relation(fields: [mechanismId], references: [id], onDelete: Cascade)

  @@id([concernId, mechanismId])
  @@map("BodyAreaMuscleGroup")
}

// Mapped to the original "Exercise" table. Named Practice because the catalog
// now holds breathwork and gaze resets alongside stretches.
model Practice {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String
  instructions    String
  difficulty      Difficulty @default(BEGINNER)
  durationSeconds Int        @default(40)
  // Which goals this practice is well-suited for.
  goals           Goal[]
  equipment       String     @default("none")

  modality Modality @default(MOVEMENT)
  posture  Posture  @default(ANY)
  // True = invisible on a video call or at a shared desk. A hard filter, not a preference.
  discreet Boolean  @default(false)
  // 1 = still and silent, 2 = normal, 3 = raises heart rate or needs floor space.
  exertion Int      @default(2)
  // e.g. "4-4-8" (in-hold-out) or "4-4-4-4" (in-hold-out-hold). When set, the
  // player drives a breath pacer instead of a plain countdown ring.
  breathPattern String?
  // Key into the animated-figure registry. Falls back to the modality's generic
  // animation, then to text only, so the catalog can outrun the artwork.
  animationKey  String?

  createdAt DateTime @default(now())

  mechanisms   PracticeMechanism[]
  concerns     PracticeConcern[]
  plannedItems PlannedSessionItem[]

  @@index([modality])
  @@map("Exercise")
}

// How strongly a practice acts on a mechanism, 0-100. Replaces `isPrimary`.
model PracticeMechanism {
  practiceId  String @map("exerciseId")
  mechanismId String @map("muscleGroupId")
  weight      Int    @default(50)

  practice  Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  mechanism Mechanism @relation(fields: [mechanismId], references: [id], onDelete: Cascade)

  @@id([practiceId, mechanismId])
  @@map("ExerciseMuscleGroup")
}

// SPARSE signed override on top of mechanism routing. Positive = hand-curated
// "this is THE thing for X". Large negative = never suggest for X.
model PracticeConcern {
  practiceId String
  concernId  String
  weight     Int    @default(0)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  concern  Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([practiceId, concernId])
}

// One per user per calendar day: the generated sessions for that day.
model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // normalized to midnight UTC of the plan's day
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]

  @@unique([userId, date])
}

model PlannedSession {
  id              String        @id @default(cuid())
  dailyPlanId     String
  slot            SessionSlot
  origin          SessionOrigin @default(DAILY_PLAN)
  title           String
  focusLabel      String
  durationMinutes Int
  startedAt       DateTime?
  completedAt     DateTime?
  skippedAt       DateTime?
  // Set when this session was built from an explicit "how I feel right now" log.
  stateLogId      String?       @unique

  dailyPlan DailyPlan               @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  stateLog  StateLog?               @relation(fields: [stateLogId], references: [id], onDelete: SetNull)
  items     PlannedSessionItem[]
  concerns  PlannedSessionConcern[]
  feedback  SessionFeedback?

  @@index([dailyPlanId, slot])
  @@index([dailyPlanId, origin])
}

model PlannedSessionItem {
  id               String @id @default(cuid())
  plannedSessionId String
  practiceId       String @map("exerciseId")
  order            Int
  durationSeconds  Int

  plannedSession PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  practice       Practice       @relation(fields: [practiceId], references: [id])

  @@unique([plannedSessionId, order])
  @@map("PlannedSessionExercise")
}

// Records what a session was BUILT FOR, rather than reverse-engineering it from
// practice-mechanism links at read time (which silently drops practices whose
// mechanism isn't primary anywhere, and collapses entirely once mental concerns
// share mechanisms like parasympathetic-downshift).
model PlannedSessionConcern {
  plannedSessionId String
  concernId        String
  rank             Int    @default(0)

  plannedSession PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  concern        Concern        @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([plannedSessionId, concernId])
}

model SessionFeedback {
  id               String         @id @default(cuid())
  plannedSessionId String         @unique
  scale            IntensityScale @default(PAIN)
  intensityBefore  Int            @map("painBefore")
  intensityAfter   Int            @map("painAfter")
  helped           Boolean
  durationRight    Boolean
  wantMore         Boolean
  createdAt        DateTime       @default(now())

  plannedSession PlannedSession           @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  readings       SessionFeedbackReading[]
}

// Secondary per-concern readings, for routines that mixed concerns
// ("stressed AND neck tight").
model SessionFeedbackReading {
  id         String         @id @default(cuid())
  feedbackId String
  concernId  String
  scale      IntensityScale
  before     Int
  after      Int

  feedback SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  concern  Concern         @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, concernId])
}

// A point-in-time "here's how I actually feel" reading. Drives the instant
// routine builder and gives the coach real recent context.
model StateLog {
  id               String      @id @default(cuid())
  userId           String
  source           StateSource
  intensity        Int? // 0-10 on the dominant concern's scale
  minutesAvailable Int?
  posture          Posture?
  discreetRequired Boolean     @default(false)
  note             String?
  createdAt        DateTime    @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns StateLogConcern[]
  session  PlannedSession?

  @@index([userId, createdAt])
}

model StateLogConcern {
  stateLogId String
  concernId  String
  rank       Int    @default(0) // 0 = the main thing they picked

  stateLog StateLog @relation(fields: [stateLogId], references: [id], onDelete: Cascade)
  concern  Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([stateLogId, concernId])
}

// One per user per calendar day: the quick "how are you feeling" check-in.
model CheckIn {
  id        String      @id @default(cuid())
  userId    String
  date      DateTime // normalized to midnight UTC
  mood      CheckInMood
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CoachMessage {
  id                       String    @id @default(cuid())
  userId                   String
  role                     CoachRole
  content                  String
  // Slug of the suggested concern, so the handoff to the routine builder is an
  // id lookup rather than a fuzzy name match.
  suggestedConcernSlug     String?   @map("suggestedFocus")
  suggestedDurationMinutes Int?
  createdAt                DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan?
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A browser push endpoint. One user can have several (laptop, phone, work machine).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  // Cleared when a send fails with 404/410 so dead endpoints stop being retried.
  failedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// When a user wants to be nudged to move. One per user.
model ReminderSchedule {
  id        String  @id @default(cuid())
  userId    String  @unique
  enabled   Boolean @default(true)
  // Minutes from local midnight, so 540 = 09:00.
  startMinute Int   @default(540)
  endMinute   Int   @default(1020)
  /// How often to nudge, in minutes.
  intervalMinutes Int @default(90)
  /// 0 = Sunday .. 6 = Saturday. Defaults to weekdays.
  weekdays  Int[]  @default([1, 2, 3, 4, 5])
  /// IANA zone, e.g. "Europe/London". The schedule is meaningless without it.
  timezone  String @default("UTC")
  /// Set by "remind me later"; suppresses nudges until this instant.
  snoozeUntil DateTime?
  /// Guards against double-sending when the scheduler fires more than once.
  lastSentAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
